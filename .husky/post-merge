#!/bin/sh
# graphify: rebuild the code knowledge graph after a merge (AST only, no LLM).
# Detached so the merge returns immediately; log: ~/.cache/graphify-rebuild.log
_GRAPHIFY_LOG="$HOME/.cache/graphify-rebuild.log"
mkdir -p "$(dirname "$_GRAPHIFY_LOG")"

if command -v graphify >/dev/null 2>&1; then
  echo "[graphify] Merge detected - launching background rebuild (log: $_GRAPHIFY_LOG)"
  ( graphify update . >>"$_GRAPHIFY_LOG" 2>&1 & )
else
  echo "[graphify] graphify not on PATH; skipped post-merge update" >>"$_GRAPHIFY_LOG"
fi
