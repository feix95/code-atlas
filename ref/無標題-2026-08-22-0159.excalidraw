      "link": null,
      "locked": false,
      "text": "在**空白区域**右键，弹出页签品类的菜单栏。\n勾选=显示，不选=不显示。",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "在**空白区域**右键，弹出页签品类的菜单栏。\n勾选=显示，不选=不显示。",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
